# Benchmark client: Python 3.12 + uv + Rust, so pgtoken_rs (py/, maturin) builds from source,
# plus the o200k tokenizer files baked in so a run needs no network.
#
# Build from the repo root (the client needs core/ and py/ to build pgtoken_rs):
#   docker build -f paper/docker/Dockerfile.client -t pgtoken-paper-client:0.1.0 \
#       --build-arg PGTOKEN_GIT_SHA=$(git rev-parse --short HEAD) .
FROM python:3.12-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates build-essential pkg-config procps \
 && rm -rf /var/lib/apt/lists/*

# Rust 1.88 is pgtoken-core's minimum (rust-version in py/Cargo.toml).
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.88.0

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /uvx /usr/local/bin/
ENV UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON=/usr/local/bin/python3.12 UV_LINK_MODE=copy \
    PATH=/opt/venv/bin:$PATH

WORKDIR /pgtoken
# Dependencies first, so editing a benchmark script does not rebuild the Rust client.
# pyfastpfor and constriction are only for token-storage's offline codec baselines (imported
# lazily by tnbench), not for any paper script, so they are skipped.
COPY pyproject.toml uv.lock ./
COPY core core
COPY py py
RUN uv sync --frozen --no-install-package pyfastpfor --no-install-package constriction
# pyarrow reads the DBpedia parquet shards in paper/prep_data.py. Paper-only, so it is pinned
# here rather than added to the benchmarks' lockfile.
RUN uv pip install --python /opt/venv/bin/python pyarrow==18.1.0

# Tokenizer files, pinned. tiktoken caches its BPE files under TIKTOKEN_CACHE_DIR; the HF
# tokenizer.json files are the ones benchmarks/pgcommon.py pins (O200K_HF).
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken PGTOKEN_O200K_DIR=/opt/o200k
RUN python -c "import tiktoken; [tiktoken.get_encoding(e) for e in ('o200k_base', 'r50k_base')]" \
 && mkdir -p /opt/o200k \
 && curl -sSfL -o /opt/o200k/Xenova--gpt-4o@7956d98f2a83b2751a98ea7136fdf7fe6cf54e69.tokenizer.json \
      https://huggingface.co/Xenova/gpt-4o/resolve/7956d98f2a83b2751a98ea7136fdf7fe6cf54e69/tokenizer.json \
 && curl -sSfL -o /opt/o200k/openai--gpt-oss-20b@6cee5e81ee83917806bbde320786a8fb61efebee.tokenizer.json \
      https://huggingface.co/openai/gpt-oss-20b/resolve/6cee5e81ee83917806bbde320786a8fb61efebee/tokenizer.json

COPY benchmarks benchmarks
COPY scripts scripts
COPY paper paper

ARG PGTOKEN_GIT_SHA=unknown
ENV PGTOKEN_GIT_SHA=${PGTOKEN_GIT_SHA} \
    TOKEN_STORAGE_REPO=/token-storage \
    PGTOKEN_DSN="host=server port=5432 user=postgres password=postgres dbname=postgres"
CMD ["bash", "paper/run.sh", "smoke"]
