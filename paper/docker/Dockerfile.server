# PostgreSQL 16 + pgvector + the released pgtoken 0.1.1 package. Used by every paper benchmark.
#
#   docker build -f paper/docker/Dockerfile.server -t pgtoken-paper-server:0.1.1 paper/docker
#
# The image installs the .deb from the GitHub release, not a local build, so a reviewer runs
# exactly the published binary (tag v0.1.1, commit b3a13ff).
FROM pgvector/pgvector:pg16

ARG PGTOKEN_VERSION=0.1.1
ARG PGTOKEN_DEB_SHA256=6519b20934af2cc374fe6b25d6200fe360f273d6a7850664ff219ca6e99b360b
ADD --checksum=sha256:${PGTOKEN_DEB_SHA256} \
    https://github.com/KShivendu/pgtoken/releases/download/v${PGTOKEN_VERSION}/postgresql-16-pgtoken_${PGTOKEN_VERSION}_amd64.deb \
    /tmp/pgtoken.deb
RUN apt-get update \
 && apt-get install -y --no-install-recommends /tmp/pgtoken.deb \
 && rm -rf /var/lib/apt/lists/* /tmp/pgtoken.deb

# One settings file for every arm. initdb writes postgresql.conf; the init script appends an
# `include` of this file, so these values override the defaults and are visible in SHOW.
COPY postgresql.paper.conf /etc/postgresql/postgresql.paper.conf
COPY 10-paper-settings.sh /docker-entrypoint-initdb.d/10-paper-settings.sh
